{
  "name": "@konggithubdev/samp-mcp",
  "version": "1.0.12",
  "description": "An MCP server for Managing SAMP (San Andreas Multiplayer) servers with Thai (Windows-874) support.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "samp-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run check",
    "lint": "eslint src",
    "deadcode": "node scripts/check-dead-methods.mjs",
    "prune": "ts-prune -e",
    "check": "npm run lint && npm run deadcode && npm run prune && npm run build"
  },
  "keywords": [
    "samp",
    "sa-mp",
    "mcp",
    "modelcontextprotocol",
    "pawn",
    "rcon",
    "windows-874",
    "thai"
  ],
  "author": "Watcharapong Namsaeng",
  "license": "MIT",
  "repository": "https://github.com/KongGithubDev/SAMP-MCP.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.10.0",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0"
  }
}
